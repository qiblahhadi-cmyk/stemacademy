
# STEM Academy v1.1.0
# Example values only. Never enter real secrets here.

APP_ENV=development
APP_BASE_URL=http://localhost:8888
APP_TIMEZONE=Asia/Karachi

# Firebase Admin SDK
# Emulator mode requires BOTH emulator hosts and a demo-* project ID.
# Never point emulator mode at a live project.
FIREBASE_AUTH_EMULATOR_HOST=
FIRESTORE_EMULATOR_HOST=
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=

# Public Firebase configuration
# Used by the browser in a later frontend phase.

PUBLIC_FIREBASE_API_KEY=
PUBLIC_FIREBASE_AUTH_DOMAIN=
PUBLIC_FIREBASE_PROJECT_ID=
PUBLIC_FIREBASE_APP_ID=
