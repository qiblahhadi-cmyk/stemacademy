rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Browser/client SDK access is intentionally disabled. All application
    // data access must go through the authenticated Netlify API using Admin SDK.
    // Admin SDK requests bypass these rules and are protected by API checks.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
